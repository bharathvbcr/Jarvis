  "targets":{
    "member":{"role":"text_field","name":"Member ID"},"search":{"role":"button","name":"Search"},
    "new":{"role":"button","name":"New subaccount"},"name":{"role":"text_field","name":"Subaccount name"},
    "review":{"role":"button","name":"Review"},"confirm":{"role":"button","name":"Confirm creation"},
    "status":{"role":"text_field","name":"Status"}
  },
  "steps":[
    {"id":"member","kind":"set_value","target":"member","effect":"read","input":{"source":"input","key":"member_id"}},
    {"id":"search","kind":"press","target":"search","effect":"read"},
    {"id":"new","kind":"press","target":"new","effect":"read"},
    {"id":"name","kind":"set_value","target":"name","effect":"read","input":{"source":"input","key":"subaccount_name"}},
