{
  "schema_version": 1,
  "id": "bank.balance.overlay-recovery",
  "criteria": [
    {
      "id": "outcome-id",
      "fact": "outcome.id",
      "required": true,
      "predicate": {"op": "equals", "value": "success"}
    },
    {
      "id": "balance",
      "fact": "balance_minor",
      "required": true,
      "predicate": {"op": "equals", "value": 125000}
    },
    {
      "id": "currency",
      "fact": "currency",
      "required": true,
      "predicate": {"op": "equals", "value": "USD"}
    },
    {
      "id": "member-found",
      "fact": "ui.Status",
      "required": true,
      "predicate": {"op": "equals", "value": "Member found"}
    }
  ]
}
